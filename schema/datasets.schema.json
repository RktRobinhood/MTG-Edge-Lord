{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MTG Edge Lord generated dataset",
  "type": "object",
  "required": [
    "schemaVersion"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    }
  },
  "oneOf": [
    {
      "required": [
        "findings"
      ],
      "properties": {
        "windowDays": false,
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "score",
              "source"
            ]
          }
        }
      }
    },
    {
      "required": [
        "commanders"
      ],
      "properties": {
        "schemaVersion": {
          "const": 2
        },
        "commanders": {
          "$ref": "#/$defs/columnar"
        }
      }
    },
    {
      "required": [
        "cards"
      ],
      "properties": {
        "cards": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/searchEntity"
          }
        }
      }
    },
    {
      "required": [
        "resources"
      ],
      "properties": {
        "resources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "findingId",
              "title",
              "url",
              "creator",
              "resourceDepth"
            ]
          }
        }
      }
    },
    {
      "required": [
        "relationships"
      ],
      "properties": {
        "relationships": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "card",
              "commander",
              "findingIds",
              "sourceUrls",
              "relationshipScore"
            ]
          }
        }
      }
    },
    {
      "required": [
        "archive"
      ],
      "properties": {
        "archive": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "slug",
              "name",
              "firstSurfacedAt",
              "lastSurfacedAt",
              "timesSurfaced",
              "findingIds",
              "sources"
            ],
            "properties": {
              "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
              "name": { "type": "string", "minLength": 1 },
              "firstSurfacedAt": { "type": "string", "format": "date" },
              "lastSurfacedAt": { "type": "string", "format": "date" },
              "timesSurfaced": { "type": "integer", "minimum": 1 },
              "findingIds": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
              "findingTypes": { "type": "array", "items": { "type": "string" } },
              "sources": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name", "url"],
                  "properties": {
                    "name": { "type": "string", "minLength": 1 },
                    "url": { "type": "string", "format": "uri", "pattern": "^https://" },
                    "creator": { "type": "string" }
                  }
                }
              },
              "popularityAtFirstSurface": {
                "type": "object",
                "properties": {
                  "edhrecRank": { "type": "integer", "minimum": 1 },
                  "deckCount": { "type": "integer", "minimum": 0 },
                  "asOf": { "type": "string", "format": "date" }
                }
              }
            }
          }
        }
      }
    },
    {
      "required": [
        "detail"
      ],
      "properties": {
        "detail": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "highSynergyCards": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "similar": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "searchEntity": {
      "type": "object",
      "required": [
        "name",
        "slug",
        "findingIds",
        "diamondScore",
        "momentum"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "slug": {
          "type": "string",
          "minLength": 1
        },
        "findingIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "diamondScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "momentum": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "columnar": {
      "type": "object",
      "required": [
        "format",
        "count",
        "columns"
      ],
      "properties": {
        "format": {
          "const": "columnar/1"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "columns": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "raw",
                  "dict",
                  "sparse",
                  "tokens"
                ]
              },
              "values": {
                "type": "array"
              },
              "keys": {
                "type": "array"
              },
              "index": {
                "type": "array"
              },
              "fill": true,
              "vocabulary": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}

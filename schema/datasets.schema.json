{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MTG Edge Lord generated dataset",
  "type": "object",
  "required": ["schemaVersion"],
  "properties": { "schemaVersion": { "const": 1 } },
  "oneOf": [
    { "required": ["findings"], "properties": { "windowDays": false, "findings": { "type": "array", "items": { "type": "object", "required": ["id", "score", "source"] } } } },
    { "required": ["commanders"], "properties": { "commanders": { "type": "array", "items": { "$ref": "#/$defs/searchEntity" } } } },
    { "required": ["cards"], "properties": { "cards": { "type": "array", "items": { "$ref": "#/$defs/searchEntity" } } } },
    { "required": ["resources"], "properties": { "resources": { "type": "array", "items": { "type": "object", "required": ["findingId", "title", "url", "creator", "resourceDepth"] } } } },
    { "required": ["relationships"], "properties": { "relationships": { "type": "array", "items": { "type": "object", "required": ["id", "card", "commander", "findingIds", "sourceUrls", "relationshipScore"] } } } },
    { "required": ["windowDays", "asOf", "findings"], "properties": { "windowDays": { "enum": [7, 30, 90] }, "asOf": { "type": "string", "format": "date-time" } } },
    {
      "required": ["snapshots"],
      "properties": {
        "snapshots": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["date", "commanders"],
            "properties": {
              "date": { "type": "string", "format": "date" },
              "commanders": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "required": ["rank", "decks"],
                  "properties": {
                    "rank": { "type": "integer", "minimum": 0 },
                    "decks": { "type": "integer", "minimum": 0 }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "searchEntity": {
      "type": "object",
      "required": ["name", "slug", "findingIds", "diamondScore", "momentum"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "minLength": 1 },
        "findingIds": { "type": "array", "items": { "type": "string" } },
        "diamondScore": { "type": "number", "minimum": 0, "maximum": 100 },
        "momentum": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    }
  }
}
